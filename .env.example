# ========================================================
# SWEETPOP ENVIRONMENT TEMPLATE (.env.example)
# ========================================================

# Google Gemini API Key (Dapatkan gratis di https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Google Gemini Model Name
GEMINI_MODEL=gemini-2.5-flash

# Database Configuration (Laragon MySQL)
DB_HOST=127.0.0.1
DB_USER=root
DB_PASS=
DB_NAME=sweetpop

# Midtrans Payment Gateway (Sandbox Mode)
# Dapatkan Server Key di Dashboard Midtrans -> Settings -> Access Keys
MIDTRANS_SERVER_KEY=your_midtrans_server_key_here
